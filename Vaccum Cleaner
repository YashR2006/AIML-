import random
import time


battery = 100
score = 0
position = "Charging Station"

bin_capacity = 5

dust_bin = {
    1: 0,
    2: 0,
    3: 0
}

rooms = {
    1: {1: 80, 2: 20, 3: 60, 4: 40},
    2: {1: 30, 2: 90, 3: 50, 4: 10},
    3: {1: 70, 2: 40, 3: 0, 4: 100}
}



print("Vacuum Cleaner is starting...")
time.sleep(1)

print("Vacuum Cleaner is ON")

score += 1


def check_battery():

    global battery, score, position

    print("\nChecking battery...")
    print("Battery:", battery, "%")

    if battery < 30:

        print("Battery is LOW!")

        if position != "Charging Station":
            print("Returning to charging station...")
            position = "Charging Station"
            battery -= 5

        print("Charging...")

        battery = 100

        print("Battery is FULL!")

        score += 1

    else:
        print("Battery is enough.")


def check_obstacle():

    global score

    obstacle = random.choice([True, False, False, False])

    if obstacle:

        print("🚧 Obstacle detected!")

        print("Changing path...")

        time.sleep(1)

        score += 1

        print("Obstacle avoided.")

        return True

    return False



def move_to_room(floor, room):

    global battery, position

    print("\nMoving to Floor", floor, "Room", room)

    check_obstacle()

    position = "Floor " + str(floor) + " Room " + str(room)

    battery -= 5

    print("Battery:", battery, "%")



def check_room(floor, room):

    dirt = rooms[floor][room]

    print(
        "Floor", floor,
        "Room", room,
        "Dirt Level:", dirt
    )

    if dirt == 0:

        print("Room is already CLEAN.")

        return False

    else:

        print("Room is DIRTY.")

        return True



def check_bin(floor):

    global score

    if dust_bin[floor] >= bin_capacity:

        print(
            "\n🗑️ Floor", floor,
            "bin is FULL!"
        )

        print("Emptying bin...")

        dust_bin[floor] = 0

        print("Bin is empty.")

        score += 1




def clean_room(floor, room):

    global battery, score

    dirt = rooms[floor][room]

    print(
        "\nCleaning Floor",
        floor,
        "Room",
        room
    )

    check_bin(floor)

   
    battery -= 10

    dust = random.randint(1, 3)

    dust_bin[floor] += dust

    rooms[floor][room] = 0

    print("Room cleaned!")

    print("Dust collected:", dust)

    print(
        "Floor", floor,
        "Bin:",
        dust_bin[floor],
        "/",
        bin_capacity
    )

    print("Battery:", battery, "%")

    score += 1

    print("Reward +1")



def return_home():

    global position, battery, score

    print("\nReturning to charging station...")

    position = "Charging Station"

    battery -= 5

    if battery < 0:
        battery = 0

    print("Returned successfully.")

    print("Battery:", battery, "%")

    score += 1



def clean_floor(floor):

    global score

    print("\n")
    print("==============================")
    print("STARTING FLOOR", floor)
    print("==============================")

    priority_rooms = sorted(
        rooms[floor],
        key=lambda room: rooms[floor][room],
        reverse=True
    )

    print("\nRoom Priority:")

    for room in priority_rooms:
        print(
            "Room",
            room,
            "Dirt Level:",
            rooms[floor][room]
        )

    score += 1

    for room in priority_rooms:

        check_battery()

        move_to_room(floor, room)

        dirty = check_room(floor, room)

        if dirty:

            clean_room(floor, room)

        else:

            print("Skipping this room.")

            score += 1

      
        return_home()



    if dust_bin[floor] > 0:

        print(
            "\nFloor",
            floor,
            "cleaning completed."
        )

        print("Emptying Floor", floor, "bin.")

        dust_bin[floor] = 0

        score += 1

        print("Bin emptied.")

    print("\nFloor", floor, "completed!")




print("\n==============================")
print("AUTOMATIC VACUUM CLEANER")
print("==============================")


check_battery()


for floor in range(1, 4):

    print("\nChecking Floor", floor)

    check_battery()

    clean_floor(floor)



if position != "Charging Station":

    return_home()



print("\n")
print("================================")
print("       CLEANING COMPLETED")
print("================================")

print("Final Position:", position)

print("Battery:", battery, "%")

print("Final Score:", score)

print("\nDust Bins:")

for floor in dust_bin:

    print(
        "Floor",
        floor,
        ":",
        dust_bin[floor]
    )

print("\nAll 3 floors processed.")
print("Vacuum Cleaner finished.")
